    {
      "type": "report",
      "spec_version": "2.1",
      "id": "report--84e4d88f-44ea-4bcd-bbf3-b2c1c320bcb3",
      "created": "2024-03-02T00:00:00.000Z",
      "modified": "2024-03-02T00:00:00.000Z",
      "created_by_ref": "identity--a463ffb3-1bd9-4d94-b02d-74e4f1658283",
      "name": "Embassy Lure 2024: APT28 diplomatic spearphishing with HeadLace",
      "description": "APT28 (Fancy Bear) sent diplomatic-invitation spearphishing emails to European foreign ministries in February 2024. The lure linked to embassy-invite-portal.net, which staged the HeadLace dropper. The technique is classic phishing (T1566) and mirrors the 2016 political-organisation spearphishing documented against the DNC. HeadLace is new tooling; the staging domain is not shared with other clusters in this lab corpus, so attribution rests on lure tradecraft and victimology rather than on commodity tools such as Mimikatz.",
      "published": "2024-03-02T00:00:00Z",
      "report_types": ["threat-actor", "campaign"],
      "confidence": 75,
