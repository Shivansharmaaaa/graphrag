# Hosted databases, one free cloud service per store. Copy to .env.cloud, fill in, never commit.
# Used by: make cloud-check | make cloud-seed | make cloud-api   (step-by-step: docs/cloud-setup.md)
# Values here override .env; everything not listed (LLM, JWT, budgets) still comes from .env.

# Neo4j AuraDB Free — from the credentials .txt file downloaded when the instance is created
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# MongoDB Atlas (M0 free cluster) — Connect → Drivers → Python; put the database user's password in
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=cti

# Redis Cloud (free 30 MB database) — Database → Connect: public endpoint and the default user's password
REDIS_URL=redis://default:<password>@redis-12345.c000.region.cloud.redislabs.com:12345/0

# Qdrant Cloud (free 1 GB cluster) — cluster URL (ends in :6333) and an API key from the cluster's API Keys tab
QDRANT_URL=https://xxxxxxxx-xxxx.region.cloud.qdrant.io:6333
QDRANT_API_KEY=
