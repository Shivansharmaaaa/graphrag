# Copy to .env and adjust. All services are local — no cloud API is required (NFR1).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ctiplatform
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cti
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Local LLM via Ollama (https://ollama.com) — `ollama pull llama3.1`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_S=60

# Embeddings: tfidf (offline default) | ollama (uses OLLAMA_EMBED_MODEL, e.g. nomic-embed-text)
EMBEDDER=tfidf
OLLAMA_EMBED_MODEL=nomic-embed-text

# Security — CHANGE THESE outside a lab
JWT_SECRET=change-me-in-production-please-32b
CONSUMER_API_KEY=edr-consumer-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GraphRAG query budgets
MAX_HOPS=3
HUB_DEGREE_THRESHOLD=5
MAX_NEIGHBOURS_PER_NODE=12
VECTOR_TOP_K=6
MIN_CITATION_COVERAGE=0.5
AUTO_SEED=true
