# Copy to .env and adjust. All services are local — no cloud API is required (NFR1).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ctiplatform
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cti
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Hosted Qdrant instead of host/port: QDRANT_URL=https://…:6333 and QDRANT_API_KEY (see docs/cloud-setup.md)

# Local LLM via Ollama (https://ollama.com) — `ollama pull llama3.2:3b`
# llama3.1 (8B) gives fuller answers but misses the 15 s GraphRAG p95 SLO on a laptop
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_S=60

# Embeddings: tfidf (offline default) | ollama (uses OLLAMA_EMBED_MODEL, e.g. nomic-embed-text)
EMBEDDER=tfidf
OLLAMA_EMBED_MODEL=nomic-embed-text

# Security — CHANGE THESE outside a lab
JWT_SECRET=change-me-in-production-please-32b
CONSUMER_API_KEY=edr-consumer-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GraphRAG query budgets
MAX_HOPS=3
HUB_DEGREE_THRESHOLD=5
MAX_NEIGHBOURS_PER_NODE=12
VECTOR_TOP_K=6
MIN_CITATION_COVERAGE=0.5
AUTO_SEED=true

# LLM prompt budget: prompt evaluation dominates local-LLM latency, so the model sees a trimmed
# evidence pack (the UI and audit log keep the full evidence). Raise for quality, lower for speed.
LLM_MAX_FACTS=30
LLM_MAX_DOCS=6
LLM_DOC_CHARS=300
LLM_MAX_IOCS=12
LLM_NUM_PREDICT=320
LLM_KEEP_ALIVE=30m
